<h1>ゲームアイデア一覧</h1>

<% if notice.present? %>
  <p><%= notice %></p>
<% end %>

<p><%= link_to "新しいアイデアを登録", new_game_idea_path %></p>

<% if @game_ideas.any? %>
  <ul>
    <% @game_ideas.each do |game_idea| %>
      <li>
        <h2><%= link_to game_idea.title, game_idea_path(game_idea) %></h2>
        <p>ジャンル：<%= game_idea.genre %></p>
        <p><%= game_idea.description %></p>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>まだゲームアイデアはありません。</p>
<% end %>
