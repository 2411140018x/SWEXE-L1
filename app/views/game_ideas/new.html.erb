<h1>ゲームアイデアを登録</h1>

<% if @game_idea.errors.any? %>
  <div role="alert">
    <p>入力内容を確認してください。</p>
    <ul>
      <% @game_idea.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @game_idea do |form| %>
  <p>
    <%= form.label :title, "タイトル" %><br>
    <%= form.text_field :title %>
  </p>
  <p>
    <%= form.label :genre, "ジャンル" %><br>
    <%= form.text_field :genre %>
  </p>
  <p>
    <%= form.label :description, "概要" %><br>
    <%= form.text_area :description, rows: 5 %>
  </p>
  <%= form.submit "登録する" %>
<% end %>

<p><%= link_to "一覧に戻る", game_ideas_path %></p>
