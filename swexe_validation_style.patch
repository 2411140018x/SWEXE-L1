diff --git a/app/assets/stylesheets/application.css b/app/assets/stylesheets/application.css
--- a/app/assets/stylesheets/application.css
+++ b/app/assets/stylesheets/application.css
@@ -1,10 +1,72 @@
-/*
- * This is a manifest file that'll be compiled into application.css.
- *
- * With Propshaft, assets are served efficiently without preprocessing steps. You can still include
- * application-wide styles in this file, but keep in mind that CSS precedence will follow the standard
- * cascading order, meaning styles declared later in the document or manifest will override earlier ones,
- * depending on specificity.
- *
- * Consider organizing styles into separate files for maintainability.
- */
+:root {
+  color-scheme: light;
+  font-family: "Hiragino Kaku Gothic ProN", "Yu Gothic", Meiryo, sans-serif;
+  color: #202a3a;
+  background: #f5f7fb;
+}
+* { box-sizing: border-box; }
+body { margin: 0; line-height: 1.7; }
+a { color: #2754bb; }
+a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible {
+  outline: 3px solid #88aaff;
+  outline-offset: 2px;
+}
+.site-header { background: #fff; border-bottom: 1px solid #e4e9f2; }
+.site-header__inner { max-width: 1024px; min-height: 68px; margin: auto; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; gap: 18px; }
+.site-brand { color: #1d376c; text-decoration: none; font-size: 1.1rem; font-weight: 800; }
+.site-header nav { display: flex; gap: 20px; }
+.site-header nav a { text-decoration: none; font-weight: 600; }
+.site-main { max-width: 1024px; margin: 0 auto; padding: 38px 24px 80px; }
+.page-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 28px; }
+.page-heading h1 { margin: 4px 0 8px; font-size: clamp(1.6rem, 4vw, 2.2rem); line-height: 1.4; overflow-wrap: anywhere; }
+.eyebrow { margin: 0; color: #3e66bd; font-size: .75rem; font-weight: 800; letter-spacing: .14em; }
+.lead { margin: 0; color: #63718a; }
+.button { display: inline-flex; justify-content: center; align-items: center; min-height: 44px; padding: 9px 18px; border: 1px solid transparent; border-radius: 9px; font: inherit; font-weight: 700; line-height: 1.45; text-decoration: none; cursor: pointer; white-space: nowrap; }
+.button--primary { color: #fff; background: #2d59bd; }
+.button--primary:hover { background: #214aab; }
+.button--subtle { color: #2d59bd; background: #eef3fc; }
+.button--subtle:hover { background: #e2eafb; }
+.button--danger { color: #b42f42; background: #fff; border-color: #e4aeb6; }
+.button--danger:hover { background: #fff1f3; }
+.panel, .idea-card, .empty-state { background: #fff; border: 1px solid #e1e7f0; border-radius: 15px; box-shadow: 0 5px 20px rgba(28, 44, 79, .04); }
+.panel { padding: clamp(22px, 4vw, 38px); }
+.idea-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 18px; padding: 0; list-style: none; }
+.idea-card { padding: 24px; display: flex; flex-direction: column; align-items: flex-start; min-height: 240px; }
+.idea-card h2 { margin: 15px 0 8px; font-size: 1.2rem; line-height: 1.5; overflow-wrap: anywhere; }
+.card-link { color: #202a3a; text-decoration: none; }
+.card-link:hover, .text-link:hover { text-decoration: underline; }
+.card-description { color: #56647c; margin: 0 0 18px; overflow-wrap: anywhere; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
+.text-link { margin-top: auto; text-decoration: none; font-weight: 700; }
+.genre-tag { display: inline-block; max-width: 100%; padding: 3px 11px; border-radius: 100px; background: #eaf0ff; color: #3053a0; font-size: .84rem; font-weight: 700; overflow-wrap: anywhere; }
+.empty-state { padding: 60px 24px; text-align: center; }
+.empty-state h2 { margin: 0; }
+.empty-state p { color: #63718a; }
+.idea-form { max-width: 650px; }
+.form-field { margin-bottom: 24px; }
+.form-field label { display: block; margin-bottom: 7px; font-weight: 700; }
+.form-field input, .form-field textarea, .field_with_errors input, .field_with_errors textarea { display: block; width: 100%; padding: 11px 13px; border: 1px solid #bfcadb; border-radius: 8px; background: #fff; color: #202a3a; font: inherit; }
+.form-field textarea { resize: vertical; min-height: 150px; }
+.form-field input[aria-invalid="true"], .form-field textarea[aria-invalid="true"] { border-color: #bf4153; }
+.form-hint { margin: 5px 0 0; color: #63718a; font-size: .86rem; }
+.field-error { color: #b0273c; font-size: .88rem; margin: 6px 0 0; }
+.form-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
+.form-actions form { margin: 0; }
+.flash { padding: 13px 18px; margin-bottom: 24px; border-radius: 9px; font-weight: 600; }
+.flash--success { color: #17563f; background: #e8f6ed; border: 1px solid #a4d9ba; }
+.flash--error, .error-summary { color: #952337; background: #fff0f1; border: 1px solid #e6abb5; }
+.error-summary { padding: 14px 18px; border-radius: 9px; margin-bottom: 24px; }
+.error-summary ul { margin: 6px 0 0; padding-left: 22px; }
+.detail-panel { max-width: 760px; }
+.detail-section + .detail-section { border-top: 1px solid #e7ebf2; margin-top: 26px; padding-top: 26px; }
+.detail-section h2 { margin: 0 0 10px; font-size: 1rem; color: #63718a; }
+.description { overflow-wrap: anywhere; white-space: normal; }
+.description p { margin: 0 0 1em; }
+.detail-actions { border-top: 1px solid #e7ebf2; padding-top: 24px; }
+@media (max-width: 620px) {
+  .site-header__inner { min-height: 64px; padding: 0 16px; }
+  .site-header nav { gap: 10px; font-size: .88rem; }
+  .site-main { padding: 26px 16px 60px; }
+  .page-heading { align-items: flex-start; flex-direction: column; gap: 16px; }
+  .page-heading > .button { width: 100%; }
+  .idea-grid { margin-top: 0; }
+}
